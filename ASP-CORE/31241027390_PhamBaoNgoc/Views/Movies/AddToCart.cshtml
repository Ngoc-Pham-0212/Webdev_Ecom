@model _31241027390_PhamBaoNgoc.Models.HoaDon
@{
    ViewBag.Title = "Giỏ hàng của bạn";
}

<div class="card shadow-sm border-0 p-4">
    <h2 class="fw-bold mb-4">🛒 Giỏ hàng của bạn</h2>

    @if (Model == null || Model.ChiTietHoaDons == null || !Model.ChiTietHoaDons.Any())
    {
        <div class="alert alert-info text-center py-4">
            <p class="mb-3 fs-5">Giỏ hàng của bạn hiện đang trống.</p>
            <a class="btn btn-primary" asp-controller="Movies" asp-action="Index">Quay lại cửa hàng chọn phim</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table id="cartTable" class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hoaDonChiTiet in Model.ChiTietHoaDons)
                    {
                        <tr>
                            <td class="fw-semibold">@hoaDonChiTiet.MovieObj.Title</td>
                            <td class="text-center">
                                <span class="badge bg-secondary px-3 py-2">@hoaDonChiTiet.SoLuong</span>
                            </td>
                            <td class="text-end">@hoaDonChiTiet.MovieObj.Price.ToString("N0") đ</td>
                            <td class="text-end fw-bold text-primary">
                                @((hoaDonChiTiet.SoLuong * hoaDonChiTiet.MovieObj.Price).ToString("N0")) đ
                            </td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-outline-danger" asp-controller="Movies" asp-action="RemoveFromCart"
                                   asp-route-maMovies="@hoaDonChiTiet.MaMovie">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="3" class="text-end fs-5 fw-bold">Tổng thanh toán:</td>
                        <td class="text-end fs-5 fw-bold text-danger">@Model.TongTien.ToString("N0") đ</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mt-4">
            <a class="btn btn-outline-secondary px-4" asp-controller="Movies" asp-action="Index">
                ← Tiếp tục mua sắm
            </a>
            <a class="btn btn-success px-4 fw-bold" asp-controller="Movies" asp-action="Checkout">
                Tiến hành đặt hàng →
            </a>
        </div>
    }
</div>