@model _31241027390_PhamBaoNgoc.Models.HoaDon

<div class="navbar-text ms-3">
    <b>Giỏ hàng của bạn:</b>
    @if (Model != null && Model.ChiTietHoaDons != null && Model.ChiTietHoaDons.Any())
    {
        <span>@Model.ChiTietHoaDons.Sum(x => x.SoLuong) sản phẩm, @Model.TongTien.ToString("N0") đ</span>
        <a class="btn btn-outline-primary btn-sm ms-2" asp-controller="Movies" asp-action="Checkout">Checkout</a>
    }
    else
    {
        <span>0 sản phẩm, 0 đ</span>
    }
</div>